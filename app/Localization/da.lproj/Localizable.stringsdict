<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%d cases</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d tilfælde</string>
			<key>other</key>
			<string>%d tilfælde</string>
		</dict>
	</dict>
	<key>%d cases saved for this prompt (kept on this Mac, outside the repo). They run as their own section.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@ gemt til denne prompt (opbevaret på denne Mac, uden for repoet). De køres som deres egen sektion.</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d testtilfælde</string>
			<key>other</key>
			<string>%d testtilfælde</string>
		</dict>
	</dict>
	<key>%d cases were left out: they share text with this prompt's examples, so they would test recall, not prediction.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@ udeladt: de deler tekst med denne prompts eksempler, så de ville teste hukommelse, ikke forudsigelse.</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d tilfælde blev</string>
			<key>other</key>
			<string>%d tilfælde blev</string>
		</dict>
	</dict>
	<key>%d categories</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d kategori</string>
			<key>other</key>
			<string>%d kategorier</string>
		</dict>
	</dict>
	<key>%d changes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d ændring</string>
			<key>other</key>
			<string>%d ændringer</string>
		</dict>
	</dict>
	<key>%d characters</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d tegn</string>
			<key>other</key>
			<string>%d tegn</string>
		</dict>
	</dict>
	<key>%d examples</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d eksempel</string>
			<key>other</key>
			<string>%d eksempler</string>
		</dict>
	</dict>
	<key>%d sentences with known mistakes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@ med kendte fejl</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
