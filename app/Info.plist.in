<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>dev.homeword.app</string>
  <key>CFBundleName</key><string>Homeword</string>
  <key>CFBundleDisplayName</key><string>Homeword</string>
  <key>CFBundleExecutable</key><string>Homeword</string>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string><string>da</string><string>de</string><string>es</string><string>fr</string><string>it</string><string>ja</string>
    <string>ko</string><string>nb</string><string>nl</string><string>pt-BR</string><string>pt-PT</string><string>sv</string><string>tr</string>
    <string>vi</string><string>zh-Hans</string><string>zh-Hant</string>
  </array>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundleShortVersionString</key><string>@VERSION@</string>
  <key>CFBundleVersion</key><string>@BUILD@</string>
  <key>LSMinimumSystemVersion</key><string>27.0</string>
  <key>LSUIElement</key><true/>
  <key>NSHighResolutionCapable</key><true/>
  <key>HomewordRepoPath</key><string>@REPO@</string>
  <key>NSHumanReadableCopyright</key><string>MIT License</string>
</dict>
</plist>
